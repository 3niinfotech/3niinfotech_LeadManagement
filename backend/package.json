{
  "name": "lead-management-crm-api",
  "version": "1.0.0",
  "description": "Lead Management CRM + Student + Visa ERP API",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate-statuses": "node scripts/migrate-enquiry-statuses.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:seed-masters": "node scripts/seed-masters.js",
    "db:seed-relational-masters": "node scripts/seed-relational-masters.js",
    "db:reset": "node scripts/reset-database.js",
    "db:backfill-enquiries": "node scripts/backfill-enquiries-from-leads.js",
    "db:create": "node scripts/setup-database.js",
    "db:setup": "node scripts/setup-database.js",
    "db:seed-enquiry-tags": "node scripts/seed-enquiry-tags.js",
    "db:seed-organization": "node scripts/seed-organization.js",
    "db:seed-counsellors": "node scripts/seed-counsellors.js",
    "db:purge-operational": "node scripts/purge-operational-keep-masters.js",
    "db:seed-qa": "node scripts/seed-qa-testing.js",
    "db:seed-role-workspace": "node scripts/seed-role-workspace-rbac.js",
    "db:reset-qa": "node scripts/purge-operational-keep-masters.js && node scripts/seed-qa-testing.js",
    "test": "node --test --test-concurrency=1 src/utils/__tests__/branch-access.test.js src/modules/attendance/__tests__/attendance-rules.test.js src/modules/rbac/__tests__/role-workspace.test.js src/test/integration/branch-isolation.test.js src/test/integration/attendance.test.js",
    "test:unit": "node --test src/utils/__tests__/branch-access.test.js src/modules/attendance/__tests__/attendance-rules.test.js src/modules/rbac/__tests__/role-workspace.test.js",
    "test:integration": "node --test --test-concurrency=1 src/test/integration/branch-isolation.test.js src/test/integration/attendance.test.js",
    "test:security": "npm run test:unit && npm run test:integration",
    "db:export": "node scripts/export-database.js",
    "db:verify-backup": "node scripts/verify-database-backup.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mysql2": "^3.22.5",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
