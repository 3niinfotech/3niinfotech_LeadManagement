NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://root:@localhost:3306/lead_management_crm"
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# CORS — production: set to your app origin. Development allows localhost + LAN IPs automatically.
CORS_ORIGIN=http://localhost:3000

# Optional: bind host (default 0.0.0.0 so phones/other PCs can reach the API)
# HOST=0.0.0.0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate limiting (production defaults; development uses higher limits in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# DEV ONLY — any ACTIVE user can also login with this password (real passwords still work).
# Default in non-production code is 123. Set to "off" to disable. Never use in production.
# DEV_UNIVERSAL_PASSWORD=123
