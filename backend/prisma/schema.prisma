// ─── FEATURE TOGGLE (Master) ─────────────────────────────────────────────────

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  module         String   @default("legacy")
  name           String
  description    String?  @db.Text
  defaultEnabled Boolean  @default(false)
  dependsOn      Json     @default("[]")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  overrides TenantFeatureOverride[]

  @@index([module])
  @@map("feature_flags")
}

model TenantFeatureOverride {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String?
  featureKey String
  enabled    Boolean
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([companyId, featureKey])
  @@index([companyId])
  @@map("tenant_feature_overrides")
}
