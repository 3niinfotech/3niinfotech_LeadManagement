// ─── PRESERVED ORPHAN TABLES (Admission / Fee) — DB source of truth ───────────

model Admission {
  id           String          @id @default(uuid())
  admissionNo  String          @unique
  enquiryId    String?         @unique
  branchId     String
  firstName    String
  lastName     String
  email        String?
  phone        String
  dateOfBirth  DateTime?
  gender       String?
  nationality  String?
  passportNo   String?
  address      String?         @db.Text
  course       String
  university   String
  intake       String?
  country      String?
  status       AdmissionStatus @default(DRAFT)
  metadata     String          @db.LongText
  createdBy    String
  updatedBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  branch    Branch              @relation(fields: [branchId], references: [id])
  enquiry   Enquiry?            @relation(fields: [enquiryId], references: [id])
  documents AdmissionDocument[]
  payments  AdmissionPayment[]
  feePlan   FeePlan?

  @@index([branchId])
  @@index([status])
  @@index([admissionNo])
  @@map("admissions")
}

model AdmissionDocument {
  id              String                  @id @default(uuid())
  admissionId     String
  name            String
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  category        String?
  isMandatory     Boolean                 @default(false)
  status          AdmissionDocumentStatus @default(PENDING)
  rejectionReason String?                 @db.Text
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@map("admission_documents")
}

model FeePlan {
  id                String        @id @default(uuid())
  admissionId       String?       @unique
  studentId         String?       @unique
  totalAmount       Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  scholarshipAmount Decimal       @default(0) @db.Decimal(12, 2)
  netAmount         Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            FeePlanStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  admission    Admission?        @relation(fields: [admissionId], references: [id])
  student      Student?          @relation(fields: [studentId], references: [id])
  installments FeeInstallment[]
  payments     AdmissionPayment[]

  @@map("fee_plans")
}

model FeeInstallment {
  id         String               @id @default(uuid())
  feePlanId  String
  title      String
  amount     Decimal              @db.Decimal(12, 2)
  dueDate    DateTime
  amountPaid Decimal              @default(0) @db.Decimal(12, 2)
  status     FeeInstallmentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  feePlan  FeePlan            @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  payments AdmissionPayment[]

  @@index([feePlanId])
  @@map("fee_installments")
}

model AdmissionPayment {
  id             String                 @id @default(uuid())
  admissionId    String?
  studentId      String?
  feePlanId      String
  installmentId  String?
  amount         Decimal                @db.Decimal(12, 2)
  mode           String
  referenceNo    String?
  receiptNo      String                 @unique
  status         AdmissionPaymentStatus @default(SUCCESS)
  idempotencyKey String                 @unique
  createdBy      String
  paidAt         DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  admission   Admission?       @relation(fields: [admissionId], references: [id])
  student     Student?         @relation(fields: [studentId], references: [id])
  feePlan     FeePlan          @relation(fields: [feePlanId], references: [id])
  installment FeeInstallment?  @relation(fields: [installmentId], references: [id])
  receipts    AdmissionReceipt[]

  @@index([admissionId])
  @@index([studentId])
  @@index([feePlanId])
  @@index([installmentId])
  @@map("admission_payments")
}

model AdmissionReceipt {
  id        String   @id @default(uuid())
  paymentId String
  receiptNo String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  details   String   @db.LongText
  createdAt DateTime @default(now())

  payment AdmissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("admission_receipts")
}

