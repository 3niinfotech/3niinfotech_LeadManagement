generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  WALK_IN
  WAITING
  IN_COUNSELLING
  COMPLETED
  CANCELLED
  APPOINTMENT
}

enum LeadPriority {
  NORMAL
  HIGH
  VIP
}

enum CounsellorPresenceStatus {
  AVAILABLE
  BUSY
  IN_COUNSELLING
  MEETING
  BREAK
  LUNCH
  TRAINING
  LEAVE
  OFFLINE
  DND
  WFH
}

enum AssignmentOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CounsellingSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StudentStatus {
  ENQUIRY
  REGISTERED
  DOCUMENT_PENDING
  APPLICATION_SUBMITTED
  OFFER_RECEIVED
  VISA_APPLIED
  VISA_GRANTED
  ENROLLED
  DEFERRED
  WITHDRAWN
}

enum VisaStatus {
  NOT_STARTED
  DOCUMENTS_COLLECTED
  APPLICATION_SUBMITTED
  BIOMETRICS_DONE
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  APPEAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONDITIONAL_OFFER
  UNCONDITIONAL_OFFER
  REJECTED
  WITHDRAWN
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  REMINDER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  HIGHLY_INTERESTED
  FOLLOW_UP
  APPOINTMENT
  DEMO_SCHEDULED
  DEMO_ATTENDED
  COUNSELLING
  DOCUMENTS_PENDING
  APPLICATION_STARTED
  CONVERTED
  HOLD
  LOST
  NOT_INTERESTED
  SPAM
  DUPLICATE
}

enum EnquiryPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
}

enum DemoAttendance {
  PRESENT
  ABSENT
  LATE
  PARTIAL
  NOT_MARKED
}

enum DemoResult {
  PENDING
  POSITIVE
  NEUTRAL
  NEGATIVE
  CONVERTED
}

enum AppointmentMode {
  ONLINE
  OFFLINE
}

enum CommunicationChannel {
  CALL
  WHATSAPP
  EMAIL
  SMS
  VOICE_NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  ASSIGN
  STATUS_CHANGE
}

enum DataScope {
  OWN
  TEAM
  BRANCH
  COMPANY
  GLOBAL
}

enum RoleActivityAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  CLONE
  PERMISSION_CHANGE
  ASSIGN_USER
  REMOVE_USER
  STATUS_CHANGE
  EXPORT
}

// Preserved orphan tables (Admission / Fee) — DB is source of truth
enum AdmissionStatus {
  DRAFT
  DOCS_PENDING
  FEE_PENDING
  APPROVAL_PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum AdmissionDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AdmissionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FeePlanStatus {
  DRAFT
  ACTIVE
  FULLY_PAID
  CANCELLED
}

enum FeeInstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

// ─── CORE ENTITIES ───────────────────────────────────────────────────────────

model Company {
  id                 String    @id @default(uuid())
  name               String
  code               String    @unique
  legalName          String?
  email              String?
  phone              String?
  address            String?   @db.Text
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  countryId          String?
  postalCode         String?
  taxNumber          String?
  registrationNumber String?
  logo               String?
  website            String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  country            Country?  @relation("CompanyPrimaryCountry", fields: [countryId], references: [id], onDelete: SetNull)
  branches           Branch[]
  users              User[]
  roles              Role[]
  featureOverrides   TenantFeatureOverride[]
  masterItems        MasterItem[]
  departments        Department[]
  countries          Country[]  @relation("CountryTenant")
  universities       University[]
  courses            Course[]
  intakes            Intake[]
  qualifications     Qualification[]
  visaTypes          VisaType[]
  documentTypes      DocumentType[]
  documentRequirements DocumentRequirement[]
  embassies          Embassy[]
  currencies         Currency[]
  paymentModes       PaymentMode[]
  taxes              Tax[]
  leadSources        LeadSource[]
  leadStatuses        CrmLeadStatus[]
  lostReasons        LostReason[]
  followupTypes      FollowupType[]
  visitPurposes      VisitPurpose[]
  counsellorSkills   CounsellorSkill[]
  communicationTemplates CommunicationTemplate[]

  @@index([code])
  @@index([countryId])
  @@map("companies")
}

model Branch {
  id           String    @id @default(uuid())
  companyId    String
  name         String
  code         String
  email        String?
  phone        String?
  address      String?   @db.Text
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  countryId    String?
  postalCode   String?
  managerId    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  company      Company   @relation(fields: [companyId], references: [id])
  country      Country?  @relation("BranchCountry", fields: [countryId], references: [id], onDelete: SetNull)
  manager      User?     @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  users        User[]
  leads        Lead[]
  students     Student[]
  enquiries    Enquiry[]
  counsellorPresences CounsellorPresence[]
  featureOverrides TenantFeatureOverride[]
  departments  Department[]
  admissions   Admission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([countryId])
  @@index([managerId])
  @@map("branches")
}

model Role {
  id             String     @id @default(uuid())
  companyId      String?
  name           String
  slug           String     @unique
  description    String?
  permissions    Json       @default("[]")
  dataScope      DataScope  @default(OWN)
  parentRoleId   String?
  hierarchyLevel Int        @default(0)
  isSystem       Boolean    @default(false)
  isCustom       Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  company        Company?   @relation(fields: [companyId], references: [id])
  parentRole     Role?      @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles     Role[]     @relation("RoleHierarchy")
  users          User[]
  rolePermissions RolePermission[]
  activityLogs   RoleActivityLog[]

  @@index([companyId])
  @@index([isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  name        String
  description String?  @db.Text
  groupName   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions  RolePermission[]
  menuItems        MenuItem[]
  userOverrides    UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MenuItem {
  id            String   @id @default(uuid())
  name          String
  icon          String?
  route         String?
  permissionKey String?
  parentId      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent     MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children   MenuItem[] @relation("MenuTree")
  permission Permission? @relation(fields: [permissionKey], references: [key])

  @@index([parentId])
  @@index([displayOrder])
  @@map("menu_items")
}

model RoleActivityLog {
  id        String             @id @default(uuid())
  roleId    String
  userId    String?
  action    RoleActivityAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?            @db.Text
  createdAt DateTime           @default(now())

  role Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User? @relation("RoleActivityActor", fields: [userId], references: [id])

  @@index([roleId])
  @@index([createdAt])
  @@map("role_activity_logs")
}

model UserPermissionOverride {
  id           String    @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean   @default(true)
  expiresAt    DateTime?
  reason       String?   @db.Text
  createdAt    DateTime  @default(now())
  createdBy    String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model User {
  id            String     @id @default(uuid())
  companyId     String?
  branchId      String?
  roleId        String
  firstName     String
  lastName      String
  email         String     @unique
  password      String
  phone         String?
  avatar        String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  preferences   Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  company       Company?   @relation(fields: [companyId], references: [id])
  branch        Branch?    @relation(fields: [branchId], references: [id])
  role          Role       @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  assignedLeads Lead[]     @relation("LeadAssignee")
  assignedStudents Student[] @relation("StudentAssignee")
  assignedEnquiries Enquiry[] @relation("EnquiryAssignee")
  assignedEnquiriesBy Enquiry[] @relation("EnquiryAssigner")
  receivedWalkIns Lead[] @relation("LeadReception")
  enquiryFollowups EnquiryFollowup[]
  enquiryAppointments EnquiryAppointment[]
  appointmentCounselling EnquiryAppointment[] @relation("AppointmentCounsellor")
  enquiryDemos EnquiryDemo[]
  demoFaculty EnquiryDemo[] @relation("DemoFaculty")
  enquiryCommunications EnquiryCommunication[]
  enquiryNotes EnquiryNote[]
  enquiryImports EnquiryImportBatch[]
  enquiryAuditLogs EnquiryAuditLog[] @relation("EnquiryAuditActor")
  notes         Note[]
  activities    Activity[]
  roleActivityLogs RoleActivityLog[] @relation("RoleActivityActor")
  permissionOverrides UserPermissionOverride[]
  counsellorPresence CounsellorPresence?
  assignmentOffers AssignmentOffer[] @relation("OfferCounsellor")
  counsellingSessions CounsellingSession[] @relation("SessionCounsellor")
  managedBranches Branch[] @relation("BranchManager")
  studentProfile  Student? @relation("StudentPortalUser")
  partnerProfile  Partner? @relation("PartnerPortalUser")

  @@index([email])
  @@index([companyId])
  @@index([branchId])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── CRM MODULE ──────────────────────────────────────────────────────────────

model Lead {
  id                String        @id @default(uuid())
  leadCode          String        @unique
  tokenNumber       String
  branchId          String
  assignedToId      String?
  receptionUserId   String?
  firstName         String
  lastName          String?
  email             String?
  phone             String
  country           String?
  interestedCourse  String?
  source            String?       @default("Walk-in")
  status            LeadStatus    @default(WAITING)
  priority          LeadPriority  @default(NORMAL)
  notes             String?       @db.Text
  followUpAt        DateTime?
  walkInAt          DateTime      @default(now())
  convertedAt       DateTime?
  studentId         String?       @unique
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  branch            Branch        @relation(fields: [branchId], references: [id])
  assignedTo        User?         @relation("LeadAssignee", fields: [assignedToId], references: [id])
  receptionUser     User?         @relation("LeadReception", fields: [receptionUserId], references: [id])
  student           Student?      @relation(fields: [studentId], references: [id])
  enquiry           Enquiry?
  activities        Activity[]
  assignmentOffers  AssignmentOffer[]
  counsellingSessions CounsellingSession[]
  assignmentAudits  AssignmentAuditLog[]

  @@index([branchId])
  @@index([assignedToId])
  @@index([receptionUserId])
  @@index([status])
  @@index([priority])
  @@index([followUpAt])
  @@index([walkInAt])
  @@index([phone])
  @@index([leadCode])
  @@index([tokenNumber])
  @@map("leads")
}

model Partner {
  id          String    @id @default(uuid())
  userId      String?   @unique
  name        String
  code        String    @unique
  type        String?
  email       String?
  phone       String?
  country     String?
  website     String?
  commission  Decimal?  @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  user        User?     @relation("PartnerPortalUser", fields: [userId], references: [id])
  students    Student[]

  @@index([code])
  @@index([userId])
  @@map("partners")
}

// ─── STUDENT MODULE ──────────────────────────────────────────────────────────

model Student {
  id              String        @id @default(uuid())
  userId          String?       @unique
  branchId        String
  partnerId       String?
  assignedToId    String?
  studentCode     String        @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  nationality     String?
  passportNo      String?
  address         String?       @db.Text
  status          StudentStatus @default(ENQUIRY)
  intake          String?
  course          String?
  university      String?
  country         String?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  branch          Branch        @relation(fields: [branchId], references: [id])
  user            User?         @relation("StudentPortalUser", fields: [userId], references: [id])
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  assignedTo      User?         @relation("StudentAssignee", fields: [assignedToId], references: [id])
  lead            Lead?
  enquiry         Enquiry?
  applications    Application[]
  visas           Visa[]
  documents       Document[]
  invoices        Invoice[]
  notes           Note[]
  activities      Activity[]
  appointments    Appointment[]
  feePlan         FeePlan?
  admissionPayments AdmissionPayment[]

  @@index([branchId])
  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([studentCode])
  @@index([email])
  @@map("students")
}

model Application {
  id              String            @id @default(uuid())
  studentId       String
  university      String
  course          String
  intake          String?
  country         String?
  status          ApplicationStatus @default(DRAFT)
  applicationNo   String?
  submittedAt     DateTime?
  offerDate       DateTime?
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  student         Student           @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("applications")
}

model Visa {
  id              String     @id @default(uuid())
  studentId       String
  country         String
  visaType        String?
  status          VisaStatus @default(NOT_STARTED)
  applicationNo   String?
  submittedAt     DateTime?
  decisionAt      DateTime?
  expiryDate      DateTime?
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  student         Student    @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("visas")
}

// ─── FINANCE MODULE ──────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  studentId     String?
  invoiceNo     String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  student       Student?      @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([invoiceNo])
  @@map("invoices")
}

// ─── SHARED ENTITIES ─────────────────────────────────────────────────────────

model Document {
  id          String    @id @default(uuid())
  studentId   String?
  entityType  String?
  entityId    String?
  name        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  category    String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([entityType, entityId])
  @@map("documents")
}

model Note {
  id          String    @id @default(uuid())
  studentId   String?
  entityType  String?
  entityId    String?
  userId      String
  content     String    @db.Text
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  student     Student?  @relation(fields: [studentId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([studentId])
  @@index([entityType, entityId])
  @@map("notes")
}

model Activity {
  id          String    @id @default(uuid())
  userId      String?
  leadId      String?
  studentId   String?
  entityType  String?
  entityId    String?
  action      String
  description String?   @db.Text
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([leadId])
  @@index([studentId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activities")
}

model Appointment {
  id          String    @id @default(uuid())
  studentId   String?
  title       String
  description String?   @db.Text
  startAt     DateTime
  endAt       DateTime?
  location    String?
  isCompleted Boolean   @default(false)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([startAt])
  @@map("appointments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SavedFilter {
  id         String   @id @default(uuid())
  userId     String
  module     String
  name       String
  filters    Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, module])
  @@map("saved_filters")
}

// ─── ENQUIRY MODULE ──────────────────────────────────────────────────────────

model Enquiry {
  id                String        @id @default(uuid())
  enquiryCode       String        @unique
  branchId          String
  assignedToId      String?
  assignedById      String?
  firstName         String
  lastName          String?
  email             String
  mobile            String
  mobileCountry     String?       @default("+91")
  alternateNo       String?
  passportNo        String?
  dateOfBirth       DateTime?
  gender            String?
  nationality       String?
  maritalStatus     String?
  address           String?       @db.Text
  highestQual       String?
  interestedCourse  String?
  testsGiven        Json          @default("[]")
  interestedCountry String?
  intake            String?
  applyLevel        String?
  source            String?
  otherReference    String?
  status            EnquiryStatus @default(NEW)
  priority          EnquiryPriority @default(MEDIUM)
  tags              Json            @default("[]")
  remark            String?       @db.Text
  lastRemark        String?       @db.Text
  dropReason        String?       @db.Text
  droppedAt         DateTime?
  convertedAt       DateTime?
  lastTouchedAt     DateTime?
  studentId         String?       @unique
  leadId            String?       @unique
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  branch            Branch        @relation(fields: [branchId], references: [id])
  assignedTo        User?         @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  assignedBy        User?         @relation("EnquiryAssigner", fields: [assignedById], references: [id])
  student           Student?      @relation(fields: [studentId], references: [id])
  lead              Lead?         @relation(fields: [leadId], references: [id])
  followups         EnquiryFollowup[]
  appointments      EnquiryAppointment[]
  demos             EnquiryDemo[]
  notes             EnquiryNote[]
  documents         EnquiryDocument[]
  communications    EnquiryCommunication[]
  auditLogs         EnquiryAuditLog[]
  admission         Admission?

  @@index([branchId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([email])
  @@index([mobile])
  @@index([passportNo])
